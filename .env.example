# G-CAP environment configuration. Copy to .env and fill in secrets.
# No secret ever lives in code or in the parameter registry.

# ---- LLM provider (OpenAI-compatible; "Luna" is the product-facing name for
# the configured primary model, kept separate from the real API model id) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_LIGHTWEIGHT=

# ---- Persistence ----
# Canonical production backend. Leave unset to use the SQLite test backend.
GCAP_DATABASE_URL=postgresql+psycopg://gcap:gcap@localhost:5432/gcap
GCAP_SQLITE_PATH=./synthetic_data/gcap_test.db

# ---- Sealed confirmatory label store ----
# Symmetric key used to decrypt confirmatory oracle labels. The harness must
# not be able to read this until a freeze manifest exists (invariant 8).
# Generate with: python -m gcap.bench.sealing generate-key
GCAP_LABEL_SEAL_KEY=

# ---- Concurrency ----
# Worker pool candidates tried during pilot: 32, 64 or 128. The largest that
# runs cleanly under the rate limiter is kept and written to the manifest.
GCAP_WORKER_POOL_CANDIDATES=32,64,128
# Real concurrent model-call semaphore. Default 64 per pilot decision
# (2026-09-21); the client-side rate limiter still enforces the account's
# actual request/token-per-minute limits underneath this ceiling.
GCAP_MODEL_CALL_SEMAPHORE=64

# ---- Run mode ----
# dev | pilot | confirm | audit | roadmap
GCAP_SPLIT=dev
